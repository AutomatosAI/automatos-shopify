generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// Caches the Automatos workspace + public widget key minted by
// POST /api/shopify/provision so the embedded admin can show the merchant
// their real ak_pub_ key (Settings) instead of forcing an out-of-band curl.
// One workspace per shop; the shop domain is the natural key.
model WorkspaceCredential {
  shop              String   @id
  workspacePublicId String
  apiKey            String
  agentsInstalled   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
