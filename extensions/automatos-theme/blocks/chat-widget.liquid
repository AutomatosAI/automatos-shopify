<div
  id="automatos-chat-{{ block.id }}"
  data-automatos-widget="chat"
  data-api-key="{{ block.settings.api_key }}"
  data-agent-id="{{ block.settings.agent_id }}"
  data-position="{{ block.settings.position }}"
  data-theme="{{ block.settings.theme }}"
  data-primary-color="{{ block.settings.primary_color }}"
  data-page-type="{{ template.name | default: '' }}"
  data-page-template="{{ template | default: '' }}"
  data-product-id="{{ product.id | default: '' }}"
  data-product-handle="{{ product.handle | default: '' }}"
  data-product-type="{{ product.type | default: '' }}"
  data-product-vendor="{{ product.vendor | default: '' }}"
  data-collection-id="{{ collection.id | default: '' }}"
  data-collection-handle="{{ collection.handle | default: '' }}"
  data-shop-domain="{{ shop.permanent_domain | default: shop.domain }}"
  data-shop-currency="{{ shop.currency | default: '' }}"
  data-shop-locale="{{ request.locale.iso_code | default: '' }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-cart-item-count="{{ cart.item_count | default: 0 }}"
  style="display:none;"
></div>

<script src="https://widgets.automatos.app/v0/widget.global.js" defer crossorigin="anonymous"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof AutomatosWidget === 'undefined') return;

    {% if block.settings.respect_consent %}
    if (window.Shopify && window.Shopify.customerPrivacy) {
      var consent = window.Shopify.customerPrivacy.currentVisitorConsent();
      if (consent && consent.marketing !== 'yes') return;
    }
    {% endif %}

    AutomatosWidget.init({
      apiKey: {{ block.settings.api_key | json }},
      widget: 'chat',
      agentId: {{ block.settings.agent_id | json }},
      position: {{ block.settings.position | json }},
      theme: {{ block.settings.theme | json }},
      title: {{ block.settings.widget_title | default: shop.name | json }},
      themeOverrides: {
        '--aw-primary': {{ block.settings.primary_color | json }},
      },
      proactiveOverride: {
        enabled: {{ block.settings.proactive_enabled | json }},
        seconds: {{ block.settings.proactive_delay_seconds | default: 20 | json }},
        message: {{ block.settings.proactive_message | default: 'Need a hand finding the right product?' | json }},
      },
      pageContext: {
        pageType: {{ template.name | default: '' | json }},
        template: {{ template | default: '' | json }},
        productId: {{ product.id | default: '' | json }},
        productHandle: {{ product.handle | default: '' | json }},
        productType: {{ product.type | default: '' | json }},
        productVendor: {{ product.vendor | default: '' | json }},
        productTitle: {{ product.title | default: '' | json }},
        productPrice: {{ product.price | default: 0 | json }},
        productAvailable: {{ product.available | default: false | json }},
        collectionId: {{ collection.id | default: '' | json }},
        collectionHandle: {{ collection.handle | default: '' | json }},
        collectionTitle: {{ collection.title | default: '' | json }},
        shopDomain: {{ shop.permanent_domain | default: shop.domain | json }},
        shopCurrency: {{ shop.currency | default: '' | json }},
        shopLocale: {{ request.locale.iso_code | default: '' | json }},
        customerId: {{ customer.id | default: '' | json }},
        customerTags: {{ customer.tags | default: '' | json }},
        cartItemCount: {{ cart.item_count | default: 0 | json }},
        cartTotalPrice: {{ cart.total_price | default: 0 | json }},
      },
    });
  });
</script>

{% schema %}
{
  "name": "Automatos Support Chat",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "api_key",
      "label": "API Key",
      "info": "Your Automatos public API key (ak_pub_...)"
    },
    {
      "type": "text",
      "id": "agent_id",
      "label": "Agent ID",
      "info": "The support agent UUID. Found in Automatos app settings."
    },
    {
      "type": "text",
      "id": "widget_title",
      "label": "Widget title",
      "info": "Shown in the chat header. Defaults to your shop name. 'Powered by Automatos AI' stays in the footer.",
      "default": ""
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ]
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent colour",
      "default": "#6366f1",
      "info": "Matches your brand colour on buttons and links"
    },
    {
      "type": "checkbox",
      "id": "respect_consent",
      "label": "Respect cookie consent",
      "default": true,
      "info": "Only load chat after visitor grants marketing consent (GDPR)"
    },
    {
      "type": "header",
      "content": "Proactive engagement (beta)"
    },
    {
      "type": "checkbox",
      "id": "proactive_enabled",
      "label": "Enable proactive popups",
      "default": false,
      "info": "Show a small popup on product pages after the shopper has been browsing for a few seconds. Off by default."
    },
    {
      "type": "range",
      "id": "proactive_delay_seconds",
      "label": "Popup delay (seconds)",
      "min": 5,
      "max": 120,
      "step": 5,
      "default": 20,
      "unit": "s",
      "info": "How long the shopper must be on a product page before the popup appears."
    },
    {
      "type": "text",
      "id": "proactive_message",
      "label": "Popup message",
      "default": "Need a hand finding the right product?",
      "info": "Shown immediately while the AI agent generates a product-specific opener. Keep it short."
    }
  ]
}
{% endschema %}
